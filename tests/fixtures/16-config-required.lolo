orbital ConfigRequiredOrbital {
  entity Widget [persistent: widgets] {
    id : string!
  }
  trait WidgetView -> Widget [interaction] {
    config {
      title : string!
        @label "Title"
      subtitle : string! = "default subtitle"
        @label "Subtitle"
      icon : string = "layout-panel-top"
        @label "Icon"
    }
    state idle {
      LOAD -> idle
        (fetch Widget { id: ?id })
        (render-ui main { type: page-header, title: @config.title, subtitle: @config.subtitle, icon: @config.icon })
    }
  }
}
