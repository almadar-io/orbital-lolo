;; Stage 1 fixture — parameterized trait shape `type Browsable t = Trait ... -> T`,
;; applied via `::` to a concrete trait. `T` is substituted to `MyItem` at
;; annotation time.

type Browsable t = Trait Browse.traits.BrowseItemBrowse -> T

orbital MyOrbital {
  uses Browse from "std/behaviors/std-browse"

  entity MyItem [runtime] {
    id : string!
    name : string
  }

  trait MyItemBrowse :: Browsable MyItem = Browse.traits.BrowseItemBrowse -> MyItem {
    on INIT {
      (ref MyItem)
      (render-ui main { type: "data-list", entity: "MyItem", fields: [{ name: "name", label: "Name" }] })
    }
  }

  page "/items" -> MyItemBrowse
}
