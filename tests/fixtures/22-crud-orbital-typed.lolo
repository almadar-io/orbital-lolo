;; Stage 2 fixture — full worked typed example.
;; Declares a parameterized orbital shape `CrudOrbital T` and applies it to
;; two entities (Patient + Order). Both orbitals reuse the same composed type
;; via `::` annotations.
;;
;; The resolver verifies: (a) both entities satisfy `Auditable` (have id +
;; createdAt + createdBy), (b) each trait annotation matches its parameterized
;; shape, (c) the orbital kinds align with `CrudOrbital`. Types are stripped
;; at lower time; the output `.orb` is byte-identical to a types-less .lolo.

type Auditable = Entity {
  id : string!
  createdAt : string
  createdBy : string
}

type PatientBrowsable = Trait Browse.traits.BrowseItemBrowse -> Patient
type PatientListPage = Page -> PatientBrowsable
type PatientCrudOrbital = Orbital {
  entity: Patient
  traits: PatientBrowsable
  page: PatientListPage
}

type OrderBrowsable = Trait Browse.traits.BrowseItemBrowse -> Order
type OrderListPage = Page -> OrderBrowsable
type OrderCrudOrbital = Orbital {
  entity: Order
  traits: OrderBrowsable
  page: OrderListPage
}

orbital PatientOrbital :: PatientCrudOrbital {
  uses Browse from "std/behaviors/std-browse"

  entity Patient :: Auditable [persistent: patients] {
    id : string!
    createdAt : string
    createdBy : string
    name : string
    dateOfBirth : string
  }

  trait PatientBrowse :: PatientBrowsable = Browse.traits.BrowseItemBrowse -> Patient {
    on INIT {
      (fetch Patient)
      (render-ui main { type: "data-list", entity: "Patient", fields: [{ name: "name", label: "Name" }] })
    }
  }

  page "/patients" :: PatientListPage -> PatientBrowse
}

orbital OrderOrbital :: OrderCrudOrbital {
  uses Browse from "std/behaviors/std-browse"

  entity Order :: Auditable [persistent: orders] {
    id : string!
    createdAt : string
    createdBy : string
    total : number
    status : string
  }

  trait OrderBrowse :: OrderBrowsable = Browse.traits.BrowseItemBrowse -> Order {
    on INIT {
      (fetch Order)
      (render-ui main { type: "data-list", entity: "Order", fields: [{ name: "total", label: "Total" }] })
    }
  }

  page "/orders" :: OrderListPage -> OrderBrowse
}
