orbital ItemOrbital {
  entity Item [persistent: items] {
    id : string!
    title : string
  }

  trait ItemSearch -> Item {
    state idle {
      INIT -> idle
        (render-ui main { type: "search-input", placeholder: "Search..." })
    }
  }

  trait ItemBrowse -> Item {
    state browsing {
      INIT -> browsing
        (fetch Item)
        (render-ui main { type: "data-grid", entity: "Item" })
    }
  }

  trait ItemLayout -> Item {
    state composing {
      INIT -> composing
        (render-ui main {
          type: "stack",
          direction: "vertical",
          gap: "md",
          children: [
            "@trait.ItemSearch",
            "@trait.ItemBrowse"
          ]
        })
    }
  }
}
