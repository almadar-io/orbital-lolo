orbital BatchOrbital {
  entity Batch [persistent: batches] {
    id : string!
    batchId : string
  }

  trait BatchRunner -> Batch [interaction] {
    state idle {
      START -> idle
        (set "@entity.batchId" "@payload.batchId")
        (call-service "webhook" "send" { url: "@payload.url", event: "@payload.event" } {
          key: "@entity.batchId",
          emit: {
            success: "CLASSIFIED",
            failure: "CLASSIFY_FAILED",
            cancelled: "CLASSIFY_CANCELLED"
          }
        })
      STOP -> idle
        (cancel-call "@entity.batchId")
    }
  }
}
