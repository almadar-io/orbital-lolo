{
  "config": {
    "appName": {
      "default": "Acme",
      "description": "The organism-wide shell title every orbital's traits may forward",
      "label": "Shell title",
      "type": "string"
    },
    "pageSize": {
      "default": 10.0,
      "tier": "presentation",
      "type": "int"
    }
  },
  "name": "AcmeOrg",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "name": "title",
            "type": "string"
          }
        ],
        "name": "Widget",
        "persistence": "runtime"
      },
      "name": "Shell",
      "traits": [
        {
          "category": "interaction",
          "effectRow": [
            {
              "kind": "set",
              "resource": "@entity.title"
            }
          ],
          "linkedEntity": "Widget",
          "name": "WidgetPanel",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.title",
                    "Ready"
                  ]
                ],
                "event": "INIT",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ],
      "uses": [
        {
          "as": "Notes",
          "config": {
            "appName": {
              "default": "Acme Notes",
              "type": "unknown"
            }
          },
          "from": "almadar-behaviors/std-notes"
        }
      ]
    }
  ],
  "version": "1.0.0"
}
