
orbital CartOrbital {
  entity Cart [runtime] {
    id : string!
    items : [string]
    itemCount : int
    total : int
  }

  trait CartActions -> Cart [interaction] {
    state empty {
      ADD_ITEM -> hasItems
        (set @items (array/append @items ?item))
    }

    state hasItems {
      REMOVE_ITEM -> empty
        (set @items [])
    }
  }
}