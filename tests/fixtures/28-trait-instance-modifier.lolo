;; Stage 2 fixture — traits with no header words dispatch on the server.

orbital TaskOrbital {
  entity Task [persistent: tasks] {
    id : string!
    title : string
    status : string
  }

  trait TaskBrowse -> Task {
    state browsing {
      INIT -> browsing
        (fetch Task)
    }
  }

  trait TaskEdit -> Task {
    state editing {
      SAVE -> editing
        (persist update Task @entity)
    }
  }

  page "/tasks" -> TaskBrowse, TaskEdit
}
