;; Negative: `::` annotation references a type that was never declared.
;; Resolver returns TypeError::UnknownType with a suggestion (levenshtein
;; on registered names) in its message.

type Auditable = Entity {
  id : string!
  createdAt : string
}

orbital BadOrbital {
  entity Record :: Auditible [persistent: records] {
    id : string!
    createdAt : string
  }
  trait RecordTrait -> Record {
    state idle {
      INIT -> idle
        (fetch Record)
    }
  }
  page "/records" -> RecordTrait
}
