orbital InventoryOrbital {
  entity Inventory [runtime] {
    id : string!
    items : [string]
    itemCount : int = derived (array/length @items)
    isEmpty : bool = derived (== (array/length @items) 0)
  }
  trait InventoryActions -> Inventory {
    state idle {
      ADD -> idle
        (set @items (array/append @items ?item))
    }
  }
}
